# Server-only FastAPI origin. Browser code must never use this directly.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Timeout for Next.js BFF -> FastAPI requests.
BACKEND_REQUEST_TIMEOUT_MS=15000

# Maximum request body accepted by the generic BFF proxy.
BFF_MAX_BODY_BYTES=1048576

# Public display values only.
NEXT_PUBLIC_APP_NAME=Sadhana Card Tracker
NEXT_PUBLIC_APP_VERSION=0.4.0
