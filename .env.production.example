# Copy to .env.production and replace every secret placeholder before Docker deployment.
POSTGRES_DB=sadhana_tracker
POSTGRES_USER=sadhana
# Use a strong URL-safe password (letters, digits, _ and -) because it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_URL_SAFE_PASSWORD

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ORGANIZATION_CODE=VOICE

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_RUN_ON_STARTUP=true

FRONTEND_PORT=3000
BACKEND_HOST_PORT=8000
BACKEND_REQUEST_TIMEOUT_MS=15000
BFF_MAX_BODY_BYTES=1048576
NEXT_PUBLIC_APP_NAME=Sadhana Card Tracker
